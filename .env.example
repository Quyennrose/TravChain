PORT=5050
CLIENT_ORIGIN=http://localhost:5173
VITE_API_PROXY_TARGET=http://127.0.0.1:5050
# Leave empty on Vercel when using the bundled /api serverless function.
VITE_API_BASE_URL=
# Local example: mongodb://127.0.0.1:27017/travchain
# Vercel production should use MongoDB Atlas: mongodb+srv://...
MONGODB_URI=mongodb://127.0.0.1:27017/travchain
JWT_SECRET=change-this-secret-before-production
DEMO_ACCOUNTS_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=12000
